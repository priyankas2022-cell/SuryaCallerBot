# Environment configuration template
# Copy this file to .env and fill in your actual values

# --------------------------
# Twilio Configuration
# --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------
# Vobiz Configuration
# --------------------------
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_DID_NUMBER=

# --------------------------
# TURN Server Configuration
# --------------------------
TURN_SECRET=

# --------------------------
# Internal Security
# --------------------------
OSS_JWT_SECRET=ChangeMeInProduction

# --------------------------
# Telemetry / Error Tracking
# --------------------------
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.posthog.com

# --------------------------
# Local Development Settings
# --------------------------
# Allow private backend URLs (localhost, host.docker.internal) for local development
# Set to "true" when running without a public tunnel (ngrok/cloudflared)
# For actual calls to work with telephony providers, you MUST run ngrok and set BACKEND_API_ENDPOINT
# Example: ngrok http 8000
# Then set: BACKEND_API_ENDPOINT=https://your-ngrok-url.ngrok.io
ALLOW_PRIVATE_BACKEND_URL=false
BACKEND_API_ENDPOINT=
